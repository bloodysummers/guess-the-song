# ---------------------------------------------------------------------------
# Supabase configuration
# Get these from: Supabase Dashboard -> Project Settings -> API Keys
# (or run `supabase status` for local dev values)
# ---------------------------------------------------------------------------

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Client-side key — safe to expose in the browser.
# New key system: this is the "Publishable key" (sb_publishable_...).
# Legacy key system: this is the "anon" key (a JWT).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side key — NEVER expose to the client (no NEXT_PUBLIC_ prefix).
# Bypasses Row Level Security; used only by server code for authoritative writes
# (sealing buzz timestamps, judging). Treat it like a password.
# New key system: this is the "Secret key" (sb_secret_...).
# Legacy key system: this is the "service_role" key (a JWT).
# Optional until the Round/Buzzer phase — the client only needs URL + publishable key.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ---------------------------------------------------------------------------
# YouTube Data API v3
# Get it from: Google Cloud Console -> APIs & Services -> Credentials -> API key,
# with the "YouTube Data API v3" enabled for the project.
# ---------------------------------------------------------------------------

# Server-only (no NEXT_PUBLIC_ prefix) — used to read a public playlist when the
# host creates a game from a YouTube / YouTube Music URL. Never reaches the browser.
# Optional: without it, only curated playlists can be used as a game source.
YOUTUBE_API_KEY=your-youtube-data-api-key
